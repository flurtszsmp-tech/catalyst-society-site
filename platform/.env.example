# ============================================================
# Salin berkas ini menjadi .env.local lalu isi nilainya.
# .env.local tidak ikut ter-commit (lihat .gitignore).
#
# Kosongkan dua nilai Supabase untuk menjalankan MODE DEMO:
# seluruh Passport memakai data contoh di browser, tanpa login.
# ============================================================

# Supabase Dashboard > Project Settings > API
#   Project URL
NEXT_PUBLIC_SUPABASE_URL=
#   anon public key (atau publishable key, sb_publishable_...)
#   Aman berada di browser: data dijaga Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alamat situs setelah deploy, tanpa garis miring di akhir.
# Dipakai untuk tautan berbagi profil dan pratinjau LinkedIn/WhatsApp.
# Lokal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# JANGAN pernah menaruh service_role key di variabel NEXT_PUBLIC_.
# Aplikasi ini tidak membutuhkannya.
